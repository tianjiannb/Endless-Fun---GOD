{
  "paintingId": "chie",
  "opening": [
    {
      "who": "sys",
      "t": "画面像水一样化开。颜料没干，墙在慢慢淌。"
    },
    {
      "who": "naron",
      "t": "又是一幅。"
    },
    {
      "who": "sys",
      "t": "有人在你面前坐下。她低着头，没看你。"
    },
    {
      "who": "chie",
      "t": "……你也是来看画的。"
    },
    {
      "who": "chie",
      "t": "前面七百三十个，都没跟我说话。"
    },
    {
      "who": "naron",
      "t": "他们站一会儿，点个头，就走了。"
    },
    {
      "who": "chie",
      "t": "我数着呢。七百三十次。"
    },
    {
      "who": "sys",
      "t": "她的笔尖停在半空，断了一截。"
    },
    {
      "who": "chie",
      "t": "你要问我点什么吗。"
    },
    {
      "who": "sys",
      "t": "问吧。这是唯一一次机会。"
    }
  ],
  "nodes": [
    {
      "id": "ask_1",
      "kind": "choice",
      "options": [
        {
          "id": "ask_1_a",
          "text": "你是谁？",
          "reply": [
            {
              "who": "chie",
              "t": "画里的人。"
            },
            {
              "who": "chie",
              "t": "……名字很久没人叫了，我自己也快忘了。"
            }
          ]
        },
        {
          "id": "ask_1_b",
          "text": "你看起来不太好。",
          "reply": [
            {
              "who": "chie",
              "t": "我不好很多年了。"
            },
            {
              "who": "chie",
              "t": "习惯了，就不算不好。"
            }
          ]
        },
        {
          "id": "ask_1_c",
          "text": "你在等什么人吗？",
          "reply": [
            {
              "who": "chie",
              "t": "等一个肯把话说完的人。"
            },
            {
              "who": "chie",
              "t": "前面那些都只说到一半。"
            }
          ]
        }
      ]
    },
    {
      "id": "after_ask_1",
      "kind": "lines",
      "lines": [
        {
          "who": "chie",
          "t": "我不怪他们。"
        },
        {
          "who": "chie",
          "t": "他们进来的时候是笑着的，出去的时候也是笑着的。中间那段，他们看画。"
        },
        {
          "who": "naron",
          "t": "她记这个记得很清楚。"
        },
        {
          "who": "chie",
          "t": "你有没有过这种感觉——你想说一句话，可你知道说出来也没人接。"
        }
      ]
    },
    {
      "id": "ask_2",
      "kind": "choice",
      "options": [
        {
          "id": "ask_2_a",
          "text": "有一个是真的吗？",
          "reply": [
            {
              "who": "chie",
              "t": "有一个。就一个。"
            },
            {
              "who": "chie",
              "t": "他站得比谁都久，久到我以为他要说话了。"
            }
          ]
        },
        {
          "id": "ask_2_b",
          "text": "为什么不自己打开窗？",
          "reply": [
            {
              "who": "chie",
              "t": "我试过。"
            },
            {
              "who": "chie",
              "t": "手穿过去了。画里没有开窗这个动作。"
            }
          ]
        },
        {
          "id": "ask_2_c",
          "text": "有人不让你画吗？",
          "reply": [
            {
              "who": "chie",
              "t": "没人不让。"
            },
            {
              "who": "chie",
              "t": "是画完了也没人看。这比不让更难受。"
            }
          ]
        }
      ]
    },
    {
      "id": "after_ask_2",
      "kind": "lines",
      "lines": [
        {
          "who": "chie",
          "t": "可你不知道那种感觉……"
        },
        {
          "who": "chie",
          "t": "你根本不知道外面长什么样。"
        },
        {
          "who": "chie",
          "t": "我知道海是蓝的。我知道蓝有很多种。我一个都没见过。"
        },
        {
          "who": "sys",
          "t": "她抬起手，又放下。"
        },
        {
          "who": "chie",
          "t": "帮我改掉一笔。"
        },
        {
          "who": "chie",
          "t": "就一笔。让我看看它变成别的样子是什么感觉。"
        }
      ]
    },
    {
      "id": "wave_2_move",
      "kind": "lines",
      "tag": "wave_2",
      "lines": [
        {
          "who": "sys",
          "t": "她换了个坐姿，把腿挪到一边。"
        },
        {
          "who": "move",
          "t": "画面跟着挪了半寸，刚才挡住的地方露出来了。"
        },
        {
          "who": "chie",
          "t": "别急着看。那儿也不对。"
        },
        {
          "who": "chie",
          "t": "裙摆下面，还有画框那边——你自己看。"
        }
      ]
    },
    {
      "id": "wave_3_move",
      "kind": "lines",
      "tag": "wave_3",
      "lines": [
        {
          "who": "sys",
          "t": "她抬起头，侧过身去。"
        },
        {
          "who": "move",
          "t": "光斜进来，画框边上原本看不清的地方显出来了。"
        },
        {
          "who": "chie",
          "t": "……你还在。"
        },
        {
          "who": "chie",
          "t": "七百三十个人里，没有一个看到这里。"
        }
      ]
    },
    {
      "id": "ask_3",
      "kind": "choice",
      "tag": "after_wave_2",
      "options": [
        {
          "id": "ask_3_a",
          "text": "先告诉我真相。",
          "reply": [
            {
              "who": "chie",
              "t": "真相是——我不是被画坏的。"
            },
            {
              "who": "chie",
              "t": "我是画到一半，画的人走了。"
            }
          ]
        },
        {
          "id": "ask_3_b",
          "text": "改掉之后呢？",
          "reply": [
            {
              "who": "chie",
              "t": "改掉之后，我可能就不是这幅画了。"
            },
            {
              "who": "chie",
              "t": "……那也挺好。"
            }
          ]
        },
        {
          "id": "ask_3_c",
          "text": "好，我改。",
          "reply": [
            {
              "who": "chie",
              "t": "谢谢。"
            },
            {
              "who": "chie",
              "t": "真的。"
            }
          ]
        }
      ]
    },
    {
      "id": "ask_end",
      "kind": "ending",
      "options": [
        {
          "id": "go_together",
          "text": "一起去。",
          "reply": [
            {
              "who": "chie",
              "t": "一起？"
            },
            {
              "who": "chie",
              "t": "……那我把窗留着，别关。"
            }
          ]
        },
        {
          "id": "you_go",
          "text": "你自己去。",
          "reply": [
            {
              "who": "chie",
              "t": "我自己去。"
            },
            {
              "who": "chie",
              "t": "好。我记住了这句话。"
            }
          ]
        },
        {
          "id": "come_again",
          "text": "我还会再来。",
          "reply": [
            {
              "who": "chie",
              "t": "你说了啊。"
            },
            {
              "who": "chie",
              "t": "我数着的。第七百三十一个。"
            }
          ]
        }
      ]
    }
  ],
  "flaws": [
    {
      "id": "f1",
      "intro": [
        {
          "who": "chie",
          "t": "嘴角在抖。它一直是抖的，我按不住。"
        }
      ],
      "after": [
        {
          "who": "chie",
          "t": "……原来不抖是这样的。"
        }
      ]
    },
    {
      "id": "f2",
      "intro": [
        {
          "who": "chie",
          "t": "笔尖断了。我一直没敢看它。"
        }
      ],
      "after": [
        {
          "who": "chie",
          "t": "补上了。它又能落笔了。"
        }
      ]
    },
    {
      "id": "f3",
      "intro": [
        {
          "who": "chie",
          "t": "窗外是白的。全是白的。"
        },
        {
          "who": "chie",
          "t": "他们说外面有海。我只画得出白。"
        }
      ],
      "after": [
        {
          "who": "chie",
          "t": "……原来白下面是有东西的。"
        }
      ]
    },
    {
      "id": "f4",
      "intro": [
        {
          "who": "chie",
          "t": "我的五官太淡了。淡到有时候我自己都找不着。"
        }
      ],
      "after": [
        {
          "who": "chie",
          "t": "现在我摸得到自己的脸了。"
        }
      ]
    },
    {
      "id": "f5",
      "intro": [
        {
          "who": "chie",
          "t": "窗台积了灰。一千年没人擦过。"
        }
      ],
      "after": [
        {
          "who": "chie",
          "t": "刻字还在。是我自己刻的。"
        }
      ]
    },
    {
      "id": "f6",
      "intro": [
        {
          "who": "chie",
          "t": "影子离我三步远。它不肯靠近。"
        }
      ],
      "after": [
        {
          "who": "chie",
          "t": "影子回来了。它一直是我的。"
        }
      ]
    }
  ],
  "standAll": [
    {
      "who": "move",
      "t": "她站起来了。这幅画一千年来第一次有人站起来。"
    },
    {
      "who": "chie",
      "t": "原来站着，窗就在这个高度。"
    },
    {
      "who": "chie",
      "t": "我叫千绘。"
    },
    {
      "who": "chie",
      "t": "一千年了，第一次有人问我叫什么。"
    }
  ],
  "standPart": [
    {
      "who": "move",
      "t": "她站起来了。画还留着几处没改。"
    },
    {
      "who": "chie",
      "t": "不用全改。"
    },
    {
      "who": "chie",
      "t": "有人肯动手，我已经知道了。"
    },
    {
      "who": "chie",
      "t": "我叫千绘。"
    }
  ],
  "finale": [
    {
      "who": "sys",
      "t": "颜料开始从边缘往里退。"
    },
    {
      "who": "chie",
      "t": "别急着走。"
    },
    {
      "who": "chie",
      "t": "你看——窗是开着的。"
    },
    {
      "who": "sys",
      "t": "海的声音是从画里出来的。"
    },
    {
      "who": "chie",
      "t": "我记得你的手。"
    },
    {
      "who": "chie",
      "t": "它停在过我的嘴角。"
    },
    {
      "who": "sys",
      "t": "画面碎成很多片，每一片都还是画。"
    },
    {
      "who": "chie",
      "t": "下次来，我画给你看。"
    }
  ]
}