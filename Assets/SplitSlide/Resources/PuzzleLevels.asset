  levels:
  - title: "初识滑行"
    hint: "选一个方向滑到底，只有遇到阻挡才会停下。"
    doorsInitiallyOpen: 0
    rows:
    - "#######"
    - "#T..###"
    - "#.....#"
    - "#.#...#"
    - "#.##..#"
    - "#.##.P#"
    - "#######"
  - title: "借墙转弯"
    hint: "目标不在正前方，试着借助墙壁改变路线。"
    doorsInitiallyOpen: 0
    rows:
    - "#######"
    - "#T..#.#"
    - "#.#.P.#"
    - "#.##.##"
    - "#..#..#"
    - "#.....#"
    - "#######"
  - title: "开启通路"
    hint: "踩过叶片开关可翻转对应门的状态，滑行途中也会生效。"
    doorsInitiallyOpen: 0
    rows:
    - "########"
    - "#......#"
    - "#.####.#"
    - "#T.A..P#"
    - "##.##.a#"
    - "#..#...#"
    - "#......#"
    - "########"
  - title: "一分为二"
    hint: "在紫色花朵上停下即可分裂，再让两个细胞同时占住目标叶片。"
    doorsInitiallyOpen: 0
    rows:
    - "########"
    - "#P#T#.P#"
    - "#......#"
    - "#......#"
    - "#......#"
    - "#......#"
    - "#..S...#"
    - "########"
  - title: "曲径寻路"
    hint: "沿着弯曲的通道前进，寻找能停在目标叶片上的路线。"
    doorsInitiallyOpen: 0
    rows:
    - "#########"
    - "#...#...#"
    - "#.....P.#"
    - "##.....##"
    - "##.....##"
    - "##.T.#.##"
    - "#....##S#"
    - "#.......#"
    - "#########"
  - title: "穿过暗道"
    hint: "先踩下方的叶片开关，打开上方的门，再寻找分裂位置。"
    doorsInitiallyOpen: 0
    rows:
    - "##########"
    - "#...##...#"
    - "##..#....#"
    - "#...#....#"
    - "#T.P.....#"
    - "###A##.###"
    - "#..a....S#"
    - "#........#"
    - "#........#"
    - "#..P.#...#"
    - "##########"
  - title: "双门协作"
    hint: "两个开关各自控制一扇门，分裂后一起占住两个目标。"
    doorsInitiallyOpen: 0
    rows:
    - "##########"
    - "#....SaA.#"
    - "#......#.#"
    - "#..T...#.#"
    - "#BP.....b#"
    - "#.#....###"
    - "#.#......#"
    - "#.#.#....#"
    - "#.#.....##"
    - "#P...#####"
