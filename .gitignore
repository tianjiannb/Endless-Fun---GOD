# ==========================================================
# Unity 项目 .gitignore
# 保留:Assets/(含 .meta)、ProjectSettings/、Packages/
# ==========================================================

# ---------- Unity 自动生成目录 ----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store 下载的插件工具(通常体积大且可重新导入)
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---------- Unity 生成的杂项文件 ----------
sysinfo.txt
*.stackdump
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------- 构建产物 ----------
*.apk
*.aab
*.unitypackage
*.app
*.ipa
*.exe
*.pdb
*.mdb
*.ilk
*.meta.swp

# ---------- Visual Studio / Rider / VS Code ----------
.vs/
.idea/
.vscode/
.vsconfig
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
*.VC.VC.opendb

# ---------- 测试与性能分析 ----------
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user
/[Ee]xported[Oo]bj/
/[Pp]rofil[Ee]r/
Profiler/*.raw
*.raw

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- 日志 / 临时文件 ----------
*.log
*.tmp
*.bak
*.orig
*.rej
*~
*.swp
*.swo

# ---------- 环境变量 / 密钥 ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- 项目内 agent 记忆（仅本地，不入库） ----------
.codeartsdoer/
.dsh/
.agent/
.agents/
AGENTS.md
CLAUDE.md

# ---------- 本地生成标记与临时产物 ----------
_REBUILD_GALLERY
_生成画廊.bat
/_logs/

# ---------- WorkBuddy 本地笔记 ----------
/.workbuddy/
